---
import Poster from '../components/Poster.astro';
import { movies } from '../data/movies.ts';
import Layout from '../layouts/Layout.astro';
---

<Layout title="posters | Janos' watchlist">
    <div x-data="posters">
        <div class="flex flex-wrap justify-between drop-shadow-md">
            <input
                type="text"
                x-on:input="search = $el.value.toLowerCase()"
                class="my-1 grow rounded-l-lg border border-black bg-amber-300 p-1 text-gray-900"
                placeholder="search"
            />

            <div class="inline-flex grow lg:grow-0">
                <button type="button"
                    class="my-1 grow border border-l-0 border-black bg-amber-300 px-1 text-sm text-gray-800 hover:bg-amber-500 lg:grow-0"
                    @click="reorder('release')"
                >
                    release date
                </button>
                <button type="button"
                    class="my-1 grow rounded-r-lg border border-l-0 border-black bg-amber-300 px-1 text-sm text-gray-800 hover:bg-amber-500 lg:grow-0"
                    @click="reorder('alphabetical')"
                >
                    alphabetical
                </button>
            </div>
        </div>

        <div
            x-ref="grid"
            class="grid grid-cols-2 place-items-center gap-4 p-2 md:grid-cols-3 lg:grid-cols-4 2xl:grid-cols-5"
        >
            { movies.map((movie) => ( <Poster movie={movie}/> )) }
        </div>
    </div>
</Layout>

<script>
import Alpine from 'alpinejs';

document.addEventListener('alpine:init', () => {
    Alpine.data('posters', () => ( {
            search: "",
            selectedMovie: { title: "", release: "", director: "", runtime: -1 },
            sortOrder: -1,
            watchlistData: [],
            reorder(sorter: string) {
                this.getPosters()
                    .sort(this.getSortFn(sorter))
                    .forEach((img) => {
                        this.$refs.grid.appendChild(img);
                    });
            },
            init() {
                fetch('/watchlist.json')
                  .then((response) => response.json())
                  .then((data) => {
                      this.watchlistData = data
                  });
            },
            getPosters() {
                return Array.from(this.$refs.grid.querySelectorAll("img"));
            },
            getSortFn(name: string) {
                switch (name) {
                    case "alphabetical":
                        this.sortOrder = this.sortOrder * -1;
                        return (a: HTMLImageElement, b: HTMLImageElement) => { return this.sortOrder * a.title.localeCompare(b.title); }
                    case "release":
                        this.sortOrder = this.sortOrder * -1;
                        return  (a: HTMLImageElement, b: HTMLImageElement) => { return this.sortOrder * (a.dataset.releasedate as string).localeCompare(b.dataset.releasedate as string); }
                }
            },
        }
    ))
})

Alpine.start();
</script>
