---
import Layout from '../layouts/Layout.astro';
---

<Layout title="my watchlist">
    <div class="m-auto max-w-2xl bg-black p-4">
        <div class="border-x-26 border-dashed border-white bg-black px-4 py-2">
            <div class="rounded-3xl bg-slate-50 p-3">
                <h1 class="animate-pulse p-8 text-center text-6xl font-extrabold outline-dotted md:p-28"> page</h1>
            </div>
            <div class="mt-8 rounded-3xl bg-slate-50 p-3">
                <h1 class="animate-pulse p-8 text-center text-6xl font-extrabold outline-dotted md:p-28">  not  </h1>
            </div>
            <div class="mt-8 rounded-3xl bg-slate-50 p-3">
                <h1 class="animate-pulse p-8 text-center text-6xl font-extrabold outline-dotted md:p-28">  found  </h1>
            </div>
        </div>
    </div>

</Layout>
