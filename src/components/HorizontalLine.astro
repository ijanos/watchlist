---
interface Props {
	text?: string;
}

const { text = '<>' } = Astro.props;
---
<div class="relative flex items-center py-5">
    <div class="grow border-t border-gray-400"></div>
    <span class="mx-4 shrink text-gray-400"> {text} </span>
    <div class="grow border-t border-gray-400"></div>
</div>
