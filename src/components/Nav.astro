---
const activeClass =
	'font-medium hover:bg-gray-700 hover:text-white px-1 py-1 rounded-md bg-gray-900 text-white';
const inactiveClass =
	'font-medium hover:bg-gray-700 hover:text-white px-1 py-1 rounded-md text-gray-900';

const links = [
	{ href: '/', text: 'list' },
	{ href: '/tabulator/', text: 'table' },
	{ href: '/posters/', text: 'posters' },
	{ href: '/stats/', text: 'stats' },
];
---

<nav>
    <div class="mx-auto max-w-7xl px-4">
        <div class="flex h-16 items-center justify-between">
            <div class="text-2xl whitespace-nowrap">
                <a class="drop-shadow-lg" href="/"
                    ><span class="font-light">my</span><span
                        class="font-semibold">watchlist</span
                    ></a
                >
            </div>
            <div class="flex space-x-1 text-xs drop-shadow-lg lg:text-base">
                {
                    links.map((link) => (
                        <a
                            href={link.href}
                            class={
                                Astro.url.pathname === link.href
                                    ? activeClass
                                    : inactiveClass
                            }
                            aria-current={Astro.url.pathname === link.href ? 'page' : undefined}
                        >
                            {link.text}
                        </a>
                    ))
                }
            </div>
        </div>
    </div>
</nav>
